<?xml version="1.0"?>
<package format="3">
  <name>buddy_robot</name>
  <version>0.1.0</version>
  <description>ROS 2 nodes for the Buddy robot car.</description>
  <maintainer email="maintainer@example.com">Buddy maintainers</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
