[Unit]
Description=Buddy wake-word conversation service
Wants=network-online.target
Wants=buddy-ros-follow.service
After=network-online.target sound.target buddy-ros-follow.service

[Service]
Type=simple
User=shofukus
Group=shofukus
WorkingDirectory=/home/shofukus/buddy
EnvironmentFile=/home/shofukus/buddy/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/shofukus/buddy/scripts/run_buddy_conversation_ros2.sh \
  --audio-backend alsa-vad \
  --audio-device plughw:CARD=Plus,DEV=0 \
  --transcription-backend openai \
  --reply-backend openai \
  --child-mode \
  --child-games \
  --memory session \
  --memory-turns 30 \
  --auto-conversation-memory \
  --conversation-memory-turns 20 \
  --mobility-backend ros2-follow \
  --mobility-stop-distance 60 \
  --mobility-resume-distance 70 \
  --power-monitor raspberry-pi \
  --speech-backend openai \
  --speech-style calm \
  --playback-backend alsa-interruptible \
  --playback-device plughw:CARD=Plus,DEV=0 \
  --turns 0 \
  --max-silence-turns 2 \
  --start-trigger wakeword \
  --wake-word-model /home/shofukus/buddy/models/wakeword/vosk-model-small-ja-0.22
ExecStopPost=/home/shofukus/buddy/scripts/stop_buddy_ros_follow.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
